{
  "name": "avpn-webflow-animations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Animation scripts for the AVPN Webflow site (built by Weblikha)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "webflow": "node scripts/dev-webflow.mjs",
    "test:codex-handoff": "node --test scripts/codex/run-handoff.test.mjs",
    "test:routing": "node --test scripts/ci/classify-paths.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install chromium chromium-headless-shell",
    "test:e2e:live": "playwright test -c playwright.live.config.js"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "locomotive-scroll": "^5.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
